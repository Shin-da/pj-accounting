# Copy this file to .env and fill it in.  .env is gitignored — never commit it.
#
#   cp .env.example .env          (PowerShell: copy .env.example .env)
#
# Then just `npm start` — no need to set anything in the terminal.

# ── database ─────────────────────────────────────────────
# Use a DEVELOPMENT database here, not the live one. Uploading a file or
# deleting an invoice while testing would hit real partner data.
#
# Local Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pj_dev
#
# Or a second (free) Supabase project used only for development — take the
# Session pooler string, not the direct connection:
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# If the password contains @ # / : or ?, URL-encode it: @ = %40, # = %23, / = %2F

# ── the superadmin ───────────────────────────────────────
# This address can manage admin/owner accounts and delete users. It cannot be
# changed from inside the app — only here.
SUPERADMIN_EMAIL=jeffmathewg@gmail.com

# ── optional ─────────────────────────────────────────────
# Signing key for session cookies. Leave unset and one is generated and stored
# in the database on first run.
# AUTH_SECRET=

# Accounts created on first run, only when the users table is empty.
# SEED_ACCOUNTS=[{"email":"admin@example.com","name":"Admin","role":"admin","password":"change-me"}]
